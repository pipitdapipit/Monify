# true = data dummy di browser (tanpa Supabase). false = pakai Supabase.
NEXT_PUBLIC_USE_MOCK=false

# Supabase: Project Settings -> API. Hanya URL + publishable key (aman di browser).
# JANGAN pakai secret / service_role key di sini.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# AI (hanya dibaca server, tanpa prefix NEXT_PUBLIC_).
# AI_MODEL boleh beberapa, dipisah koma: kalau model pertama penuh (503), model berikutnya dicoba.
# AI_PROVIDER: gemini | anthropic
AI_PROVIDER=gemini
AI_MODEL=gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-flash-lite-latest
AI_API_KEY=

# Struk (opsional)
# Bahasa OCR Tesseract. Default eng. "ind" butuh unduh data bahasa.
# OCR_LANGUAGE=eng
# Kalau true: struk yang gagal dibaca OCR dikirim sebagai gambar ke model vision (lebih mahal).
RECEIPT_VISION_FALLBACK=false
